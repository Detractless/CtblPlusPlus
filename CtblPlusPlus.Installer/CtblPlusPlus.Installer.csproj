<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\CTBL.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3800.47" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CtblPlusPlus.Application\CtblPlusPlus.Application.csproj" />
    <ProjectReference Include="..\CtblPlusPlus.Infrastructure\CtblPlusPlus.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Backend services (Engine + Wd1 + Wd2), packaged by ctbl.bat. -->
    <EmbeddedResource Include="Payload.zip" />
    <!-- Patched Cold Turkey web UI (webpack output of CtblPlusPlus.WebUI\web\Bundled),
         packaged by ctbl.bat. Applied to C:\Program Files\Cold Turkey\web during Pass 2. -->
    <EmbeddedResource Include="WebPayload.zip" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cold Turkey setup shipped beside the installer exe. LaunchColdTurkeyInstaller()
         reads it from the app's own directory, so <Link> forces it to land flat in the
         output (not under an assets\ subfolder), and PreserveNewest re-copies it on every
         build so a clean/rebuild can't strip it. -->
    <None Include="..\assets\ColdTurkey_Installer.exe">
      <Link>ColdTurkey_Installer.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- Evergreen WebView2 runtime bootstrapper (~2 MB online installer). Bundled into the
         single-file exe and self-extracted beside it; EnsureWebView2RuntimeAsync() runs it
         with /silent /install when the runtime is missing on the target machine. -->
    <None Include="..\assets\MicrosoftEdgeWebView2Setup.exe">
      <Link>MicrosoftEdgeWebView2Setup.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
