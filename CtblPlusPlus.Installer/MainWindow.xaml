<Window x:Class="CtblPlusPlus.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="CTBL Queue Delay Setup"
        WindowStyle="None"
        ResizeMode="NoResize"
        Width="920"
        Height="320"
        WindowStartupLocation="CenterScreen"
        Background="#18181B">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Slim fixed header -->
        <Grid Grid.Row="0" Background="#101012" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>


            <Button x:Name="CloseBtn" Grid.Column="1" Width="46" Height="40"
                    Background="Transparent" BorderThickness="0" Foreground="#A1A1AA"
                    Content="&#x2715;" Click="CloseButton_Click" ToolTip="Cancel Setup"
                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" />
        </Grid>

        <wv2:WebView2 Grid.Row="1" Name="webView" />
    </Grid>
</Window>

